{
  "compilerOptions": {
    "declaration": true,
    // declarationMap is required for IntelliJ to resolve source file references
    "declarationMap": true,
    "esModuleInterop": true,
    // We currently target ES5 with this package. Ignore deprecation.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler",
    "noEmit": false,
    "noImplicitAny": true,
    "outDir": "dist",
    "removeComments": false,
    "resolveJsonModule": true,
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "target": "ES5",
    "types": ["jest"]
  }
}