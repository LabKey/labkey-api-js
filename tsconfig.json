{
  "compilerOptions": {
    "declaration": true,
    // declarationMap is required for IntelliJ to resolve source file references
    "declarationMap": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler",
    "noEmit": false,
    "noImplicitAny": true,
    "outDir": "dist",
    "removeComments": false,
    "resolveJsonModule": true,
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "target": "ES2023"
  },
  // Test files are compiled by ts-jest via tsconfig.test.json, which supplies the jest types.
  // Exclude them here, so the type-check does not flag the jest globals.
  "exclude": ["**/*.spec.ts"]
}